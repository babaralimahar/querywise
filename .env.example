# Copy to .env for local development. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Local compose database (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5437/app
# Integration tests use a separate database they drop and recreate:
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5437/app_test

# LLM: "fake" costs nothing. For a real provider with an OpenAI-compatible API:
LLM_PROVIDER=fake
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id        # must also be listed in config/pricing.yaml
# LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Tracing: start jaeger with docker compose, then uncomment
# OTEL_ENDPOINT=http://localhost:4318/v1/traces

# off | embedded (inside the web process) | standalone (python -m app.worker)
WORKER_MODE=off


# Embeddings: fake (offline) or openai_compat (gemini-embedding-001, 768 dims)
EMBED_PROVIDER=fake
# JWT_SECRET=change-me-to-32+-random-bytes

# Generated SQL runs only as this read-only role (created by migration 0002)
ANALYTICS_DATABASE_URL=postgresql+asyncpg://analyst_ro:analyst-ro-dev@127.0.0.1:5437/app
# ANALYST_RO_PASSWORD=analyst-ro-dev   # read by the migration; change it outside local dev
